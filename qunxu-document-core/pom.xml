<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.qunxu</groupId>
        <artifactId>qunxu-document</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>qunxu-document-core</artifactId>
    <name>qunxu-document-core</name>
    <description>Pure-Java core of qunxu-document: parsing backends (POI / PDFBox / Tika / OpenDataLoader), unified QunxuDocument model, exporters, chunkers, parse cache, OCR gate, SSRF-guarded URL source, self-check. Zero Spring dependencies — usable as a plain library.</description>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- JSON 序列化（QunxuDocument 的 dict 导出与缓存落库格式） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- 文档解析引擎：POI（docx/xlsx/pptx）、PDFBox（PDF 文本与内嵌图）、Tika（兜底解析 + mime 探测）、
             OpenDataLoader（PDF 结构化：阅读顺序/元素级 bbox/表格合并单元格/标题层级） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.opendataloader-project.opendataloader-pdf</groupId>
            <artifactId>opendataloader-pdf-core</artifactId>
        </dependency>

        <!-- CSV 解析与字符集探测（表格文件兼容 GBK 导出） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
        </dependency>

        <!-- token 预算估算：与 Spring AI TokenCountBatchingStrategy 同用 CL100K_BASE，保证分块不超 embedding 上限 -->
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
